# Common
ENV=development
LOG_LEVEL=INFO

# LLM (stub | vertex)
# Phase 0~6 단계에서는 stub 유지. Phase 7 진입 시 vertex로 전환.
LLM_MODE=stub
# Optional per-flow override. Demo can set both to vertex.
REQUIREMENTS_LLM_MODE=
SIMULATION_LLM_MODE=
# Keep false for demos so Vertex failures fall back to deterministic stub behavior.
REQUIREMENTS_STRICT_LLM=false
ROLEPLAY_STRICT_LLM=false

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ai_org_simulation
# SQLAlchemy 쿼리 로그 (디버깅용, 평상시 false 권장)
DB_ECHO=false

# CORS
# 콤마 분리 문자열 대신 JSON 형태로 정의 (pydantic-settings list 파싱용)
CORS_ALLOW_ORIGINS=["*"]

# GCP (Phase 7~ 진입 시 채우기)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash-lite

# Firestore emulator (선택)
FIRESTORE_EMULATOR_HOST=

# Gemini API key mode (optional, do not commit real keys)
# Set LLM_MODE=gemini_api when using this key-based path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
