    "guardrails": [
      "Do not auto-add unknown requirements to taxonomy.",
      "Only map requirements to features with explicit taxonomy or rulebase support.",
      "Keep role, skill, and risk names stable for downstream scoring.",
      "Preserve source evidence for every extracted requirement before final confirmation."
    ]
  },
  "matching_policy": {
    "default_match_status": "unknown_requirements",
    "minimum_alias_confidence": 0.75,
    "minimum_taxonomy_confidence": 0.8,
    "weak_match_action": "manual_review_required",
    "unknown_requirement_action": "send_to_human_confirm",
    "auto_extend_taxonomy": false
  },
