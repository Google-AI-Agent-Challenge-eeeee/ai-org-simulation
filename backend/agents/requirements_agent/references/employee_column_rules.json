    "guardrails": [
      "Requirements Agent selects comparison criteria only; it does not evaluate individual employees.",
      "Do not use sensitive or bias-prone personal columns as matching criteria.",
      "Column selection remains draft until Human Confirm is complete.",
      "Use only columns that exist in the current CSV/model layer unless explicitly marked as unavailable."
    ]
  },
