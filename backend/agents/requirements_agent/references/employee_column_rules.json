  "requirement_type_rules": {
    "role_match": {
      "description": "Select employees whose job category and employment status match required roles.",
      "default_weight": 0.18,
      "columns": [
        {
          "source": "employee",
          "name": "job_category_code",
          "reason": "Primary role matching field."
        },
        {
          "source": "employee",
          "name": "department",
          "reason": "High-level organization grouping."
        },
        {
          "source": "employee",
          "name": "employment_status",
          "reason": "Only active or available employment states should be considered."
        },
        {
          "source": "employee",
          "name": "employment_type",
          "reason": "Contract or intern status can affect staffing assumptions."
        },
        {
          "source": "employee",
          "name": "tenure_years",
          "reason": "Seniority proxy when the schema has no explicit level field."
        }
      ]
    },
    "technical_execution": {
      "description": "Estimate ability to execute implementation-heavy requirements.",
      "default_weight": 0.16,
      "columns": [
        {
          "source": "employee",
          "name": "competency_score",
          "reason": "General capability score."
        },
        {
          "source": "employee",
          "name": "performance_score",
          "reason": "Overall recent performance."
        },
        {
          "source": "employee",
          "name": "training_hours_12m",
          "reason": "Recent learning and upskilling proxy."
        },
        {
          "source": "employee",
          "name": "certifications_count",
          "reason": "Formal qualification proxy for technical and security-heavy work."
        },
        {
          "source": "github_activity",
          "name": "commit_count_3m",
          "reason": "Recent implementation activity."
        },
        {
          "source": "github_activity",
          "name": "pr_count_3m",
          "reason": "Recent change delivery activity."
        },
        {
          "source": "github_activity",
          "name": "merged_pr_count_3m",
          "reason": "Accepted change activity."
        },
        {
          "source": "github_activity",
          "name": "repository_contribution_count",
          "reason": "Breadth of repository contribution."
        }
      ]
    },
    "delivery_reliability": {
      "description": "Estimate delivery consistency, planning quality, and issue completion reliability.",
      "default_weight": 0.14,
      "columns": [
        {
          "source": "jira_activity",
          "name": "completed_issue_count",
          "reason": "Recent completed work volume."
        },
        {
          "source": "jira_activity",
          "name": "avg_cycle_time",
          "reason": "Average delivery speed."
        },
        {
          "source": "jira_activity",
          "name": "overdue_issue_count",
          "reason": "Deadline risk signal."
        },
        {
          "source": "jira_activity",
          "name": "estimation_accuracy",
          "reason": "Planning reliability signal."
        },
        {
          "source": "jira_activity",
          "name": "sprint_completion_rate",
          "reason": "Sprint execution reliability."
        },
        {
          "source": "jira_activity",
          "name": "ownership_score",
          "reason": "End-to-end task ownership signal."
        }
      ]
    },
    "quality_assurance": {
      "description": "Select criteria for quality-sensitive requirements and regression-heavy features.",
      "default_weight": 0.12,
      "columns": [
        {
          "source": "employee",
          "name": "job_category_code",
          "reason": "QA role identification through QA job category."
        },
        {
          "source": "jira_activity",
          "name": "reopened_issue_count",
          "reason": "Low value is a quality signal; high value can indicate rework risk."
        },
        {
          "source": "jira_activity",
          "name": "issue_type_mix",
          "reason": "Bug-heavy experience can support QA or stabilization work."
        },
        {
          "source": "jira_activity",
          "name": "completed_issue_count",
          "reason": "Issue closure experience."
        },
        {
          "source": "employee",
          "name": "manager_review_score",
          "reason": "Manager-assessed reliability signal."
        },
        {
          "source": "employee",
          "name": "peer_review_score",
          "reason": "Peer-assessed collaboration and quality signal."
        }
      ]
    },
    "collaboration_communication": {
      "description": "Select criteria for cross-functional, discussion-heavy, or coordination-heavy requirements.",
      "default_weight": 0.12,
      "columns": [
        {
          "source": "slack_activity",
          "name": "collaboration_frequency",
          "reason": "Collaboration interaction frequency."
        },
        {
          "source": "slack_activity",
          "name": "avg_response_time",
          "reason": "Responsiveness proxy."
        },
        {
          "source": "slack_activity",
          "name": "communication_balance",
          "reason": "Question/answer balance proxy."
        },
        {
          "source": "slack_activity",
          "name": "thread_replies",
          "reason": "Threaded discussion participation."
        },
        {
          "source": "jira_activity",
          "name": "comment_count",
          "reason": "Issue-level collaboration activity."
        },
        {
          "source": "jira_activity",
          "name": "avg_comment_response_time",
          "reason": "Issue response speed."
        },
        {
          "source": "calendar_activity",
          "name": "external_meeting_ratio",
          "reason": "External stakeholder coordination signal."
        }
      ]
    },
    "availability_schedule": {
      "description": "Use calendar and workload proxies for schedule-sensitive requirements.",
      "default_weight": 0.12,
      "columns": [
        {
          "source": "calendar_activity",
          "name": "busy_minutes",
          "reason": "Lower busy time can indicate more capacity."
        },
        {
          "source": "calendar_activity",
          "name": "focus_time_minutes",
          "reason": "Focus capacity signal."
        },
        {
          "source": "calendar_activity",
          "name": "no_meeting_block_count",
          "reason": "Long work blocks available for deep work."
        },
        {
          "source": "calendar_activity",
          "name": "fragmented_calendar_score",
          "reason": "High fragmentation can reduce execution capacity."
        },
        {
          "source": "calendar_activity",
          "name": "total_meeting_minutes",
          "reason": "Meeting load proxy."
        },
        {
          "source": "employee",
          "name": "absence_days_12m",
          "reason": "Availability risk proxy."
        },
        {
          "source": "employee",
          "name": "remote_work_days_12m",
          "reason": "Remote work fit proxy for distributed requirements."
        }
      ]
    },
    "cost_budget": {
      "description": "Use restricted compensation proxies only when the PRD explicitly includes budget constraints.",
      "default_weight": 0.06,
      "requires_human_confirm": true,
      "columns": [
        {
          "source": "employee",
          "name": "base_salary_krw",
          "reason": "Restricted salary proxy for staffing cost."
        },
        {
          "source": "employee",
          "name": "bonus_krw",
          "reason": "Restricted compensation proxy; use only for internal cost planning."
        }
      ]
    },
    "risk_stability": {
      "description": "Select criteria for staffing risk, bottleneck risk, burnout risk, and delivery risk.",
      "default_weight": 0.1,
      "columns": [
        {
          "source": "employee",
          "name": "turnover_risk_score",
          "reason": "Retention risk proxy."
        },
        {
          "source": "employee",
          "name": "disciplinary_actions_12m",
          "reason": "Operational risk proxy."
        },
        {
          "source": "employee",
          "name": "overtime_hours_12m",
          "reason": "Workload stress proxy."
        },
        {
          "source": "slack_activity",
          "name": "burnout_risk",
          "reason": "Derived burnout signal; use carefully."
        },
        {
          "source": "slack_activity",
          "name": "bottleneck_risk",
          "reason": "Communication bottleneck risk."
        },
        {
          "source": "jira_activity",
          "name": "bottleneck_risk",
          "reason": "Delivery bottleneck risk."
        },
        {
          "source": "calendar_activity",
          "name": "early_late_meeting_ratio",
          "reason": "Work-life strain proxy."
        },
        {
          "source": "calendar_activity",
          "name": "weekend_meeting_ratio",
          "reason": "Work-life strain proxy."
        }
      ]
    }
  },
