.DS_Store
Thumbs.db

# Node
node_modules/
.pnpm-store/
.next/
dist/
coverage/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Env
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Logs
*.log

# Runtime / temp
tmp/
temp/
# Commit message scratch files (PowerShell heredoc workaround).
.git-commit-msg.tmp

# Datasets
# Rule of thumb:
#   datasets/raw/         <- COMMIT (SSOT inputs, dummy or real)
#   datasets/processed/   <- IGNORE (regenerable outputs)
#   datasets/cache/       <- IGNORE (LLM response cache, embeddings, etc.)
datasets/processed/
datasets/cache/

# Requirements Agent
# outputs/*.json files are generated by local/pipeline runs.
backend/agents/requirements_agent/outputs/*.json

# Shadow RolePlay Agent
# local simulation outputs are generated from Requirements Agent handoff packets.
backend/agents/shadow_roleplay_agent/shadow_roleplay_agent/outputs/
